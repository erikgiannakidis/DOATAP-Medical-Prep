# Copy to .env. Never commit .env. The bot token comes from BotFather.
BOT_TOKEN=
# For local Docker Compose, use db as host. Use a URL-safe password.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://doatap:REPLACE_WITH_URL_SAFE_PASSWORD@db:5432/doatap
QUESTION_BANK_PATH=data/questions.jsonl
# Optional pilot access restriction: numeric Telegram IDs separated by commas.
ALLOWED_USER_IDS=
